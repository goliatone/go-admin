{
  "name": "@goliatone/go-sync-client-workspace",
  "version": "0.0.0-phase5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "version:sync": "node ./scripts/sync-version.mjs",
    "build": "npm run build --workspaces --if-present && node ./scripts/build-sync.mjs",
    "build:sync": "npm run build",
    "verify": "node ./scripts/verify-package.mjs",
    "test": "npm run build && npm run verify && node --test tests/*.test.mjs packages/*/tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
