{
  "name": "go-admin shell",
  "env": "development",
  "server": {
    "address": ":8383",
    "print_routes": true,
    "shutdown_timeout_seconds": 10
  },
  "admin": {
    "base_path": "/admin",
    "title": "Admin Shell",
    "default_locale": "en"
  },
  "deployment": {
    "app_id": "admin-shell",
    "app_name": "Go Admin Shell",
    "app_version": "development",
    "persona_enabled": true
  },
  "auth": {
    "signing_key": "${APP_AUTH__SIGNING_KEY}",
    "demo_enabled": true,
    "show_demo_credentials": true,
    "demo_username": "admin",
    "demo_email": "admin@example.com",
    "demo_password": "${APP_AUTH__DEMO_PASSWORD}"
  },
  "features": {
    "profile": "minimal",
    "overrides": {
      "search": true
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  }
}
